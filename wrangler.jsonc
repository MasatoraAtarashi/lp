/**
 * Wrangler 設定の詳細: https://developers.cloudflare.com/workers/wrangler/configuration/
 * squat により生成。Worker 名 everyday-japan-tour は既存の本番リソース識別子なので変えない
 * （サイト名は Real Shibuya）。D1 database_id は本番の everyday-japan-tour-db を指す。
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "everyday-japan-tour",
  "compatibility_date": "2025-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/app.ts",
  // public/ 以下を Workers Static Assets として配信。アセットに無いパスだけ Worker に届く
  "assets": {
    "directory": "./public",
  },
  // 公開ドメイン。polarissea.com は Cloudflare 管理なので、deploy 時に DNS レコードごと払い出される。
  // *.workers.dev の URL も従来どおり生きる。
  "routes": [
    {
      "pattern": "realshibuya.polarissea.com",
      "custom_domain": true,
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "upload_source_maps": true,
  // GA4 measurement ID（公開値なので vars。secret にしない）。変更手順は README。
  // 値が G-XXXXXXXXXX または空のあいだはクライアントが gtag.js を読み込まない。
  "vars": {
    "GA_MEASUREMENT_ID": "G-V2L8K6GDT7",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "everyday-japan-tour-db",
      // 本番 D1 のリソース ID（secret ではない）。作り直した場合だけ差し替える。
      "database_id": "51a43ff9-266e-47ee-8b77-a06f21642473",
      "migrations_dir": "migrations",
      "migrations_table": "d1_migrations",
    },
  ],
}
