{
  "name": "everyday-japan-tour",
  "description": "Everyday Japan — photo-first page for a free Shibuya half-day walking plan, plus a quiet premium waitlist",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc --noEmit",
    "predeploy": "wrangler d1 migrations apply DB --remote",
    "deploy": "pnpm build && wrangler deploy",
    "typecheck": "pnpm cf-typegen && tsc --noEmit",
    "test": "vitest run",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "cf-typegen": "wrangler types",
    "security:ash": "ash --mode local --config .ash.yml"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "hono": "^4.13.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/node": "^24.10.1",
    "lefthook": "^2.1.14",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.134.0"
  },
  "packageManager": "pnpm@10.30.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook",
      "workerd"
    ],
    "overrides": {
      "sharp": ">=0.35.4",
      "js-yaml": ">=4.3.2"
    }
  }
}
